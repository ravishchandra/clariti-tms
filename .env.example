# Copy to .env for local dev. Never commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://tms:tms@localhost:5432/tms

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=   # single key for any model — alternative to per-provider keys
DEEPL_API_KEY=

# GitHub App
# Provide the PEM via GITHUB_APP_PRIVATE_KEY (inline, multi-line) OR via the
# _PATH variant. Env var wins when both are set.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# HMAC payload-verification secret. Do NOT use this as a GitHub API bearer
# token — installation tokens (see app/integrations/github/auth.py) are used
# for API calls.
GITHUB_WEBHOOK_SECRET=

# Contentful
CONTENTFUL_MANAGEMENT_TOKEN=

# LLM provider override (optional — overrides tms.yml)
# TMS_LLM_PROVIDER=ollama
# TMS_LLM_FALLBACK_PROVIDER=anthropic

# App
#
# SECRET_KEY: REQUIRED in production (when DEBUG=false). Used for session cookies
# and signed tokens. In dev (DEBUG=true) an empty value is auto-filled with a
# per-process random key, so this can stay blank locally — but setting it makes
# sessions stable across restarts.
#
# In production deployments DO NOT use this placeholder. Generate a real value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The historical placeholder "dev-secret-change-in-production" is explicitly
# rejected when DEBUG=false.
SECRET_KEY=
DEBUG=true

# Symmetric encryption key for at-rest webhook/CMS secrets stored in the DB.
# REQUIRED when DEBUG=false. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
