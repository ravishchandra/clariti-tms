# Secrets — never committed
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Claude Code per-user/per-machine state — accumulates allowed shell commands
# (including curl invocations that can embed dev API keys). NEVER commit this.
# The shared, safe-to-commit equivalent is `.claude/settings.json`.
.claude/settings.local.json
# Background-agent worktrees live here too; harness state only, never commit.
.claude/worktrees/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node / Next.js
node_modules/
.next/
out/
.pnpm-store/

# Local dev artifacts
*.log
*.sqlite
*.db
infra/postgres-data/
infra/pgdata/

# Screenshot capture SDK uploads (Phase 7). The v1 backend writes images
# to local disk under infra/screenshots/{key_id}/{uuid}.{ext}. Treated as
# user data — never committed.
infra/screenshots/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp

# Generated SDKs (regenerate with make sdks)
sdks/typescript/
sdks/python/

# Dart SDK (sdks/dart/) is hand-authored and committed, but its build
# artifacts are not. pubspec.lock is intentionally not committed for a library.
sdks/dart/.dart_tool/
sdks/dart/pubspec.lock
sdks/dart/.packages

# gstack / design-review tooling output (local audit artifacts, screenshots)
.gstack/
.gstack-audit/
